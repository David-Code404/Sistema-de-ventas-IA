# Copia este archivo como backend/.env y completa tus datos.
# backend/.env NO se sube a Git (esta en .gitignore).

# ── MySQL (obligatorias) ───────────────────────────────────────
# Servidor de MySQL / MariaDB (XAMPP: localhost)
DB_HOST=localhost
# Puerto de MySQL (por defecto 3306)
DB_PORT=3306
# Usuario de MySQL (XAMPP por defecto: root)
DB_USER=root
# Contrasena de MySQL (XAMPP por defecto: vacia). Pon la tuya si tienes.
DB_PASSWORD=
# Nombre de la base de datos
DB_NAME=caja_registradora_ia

# ── Archivos (opcional, ruta relativa a backend/modelo) ──
# Carpeta con las imagenes de los productos
IMAGENES_DIR=imagenes_productos

# ── API (opcional) ─────────────────────────────────────────────
# Origenes que pueden llamar a la API, separados por coma (* = todos)
CORS_ORIGINS=*
