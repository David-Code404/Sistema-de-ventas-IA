# Copia este archivo como backend/.env y completa tus datos.
# backend/.env NO se sube a Git (esta en .gitignore).

# ── MySQL (obligatorias) ───────────────────────────────────────
# Servidor de MySQL / MariaDB (XAMPP: localhost)
DB_HOST=localhost
# Puerto de MySQL (por defecto 3306)
DB_PORT=3306
# Usuario de MySQL (XAMPP por defecto: root)
DB_USER=root
# Contrasena de MySQL (XAMPP por defecto: vacia). Pon la tuya si tienes.
DB_PASSWORD=
# Nombre de la base de datos
DB_NAME=caja_registradora_ia

# ── Archivos (opcional, ruta relativa a backend/modelo) ──
# Carpeta con las imagenes de los productos
IMAGENES_DIR=imagenes_productos

# ── API (opcional) ─────────────────────────────────────────────
# Origenes que pueden llamar a la API, separados por coma (* = todos)
CORS_ORIGINS=*

# ── Correo para el segundo factor: codigo por correo (HU-24, opcionales) ──
# Sin SMTP_HOST el sistema funciona igual; solo no podra enviar codigos. Prueba con:
#   cd backend/modelo ; python probar_correo.py tu_correo@gmail.com
# Ejemplo con Gmail (necesitas la verificacion en 2 pasos y una "contrasena de aplicacion",
# se crea en https://myaccount.google.com/apppasswords ; NO uses tu clave normal):
SMTP_HOST=
# 587 con starttls (Gmail) o 465 con ssl
SMTP_PORT=587
# Tu cuenta de correo (ej. tunegocio@gmail.com)
SMTP_USER=
# La contrasena de aplicacion de esa cuenta (16 letras, sin espacios). Nunca la subas a Git.
SMTP_PASSWORD=
# Direccion que ven los usuarios como remitente (si queda vacia se usa SMTP_USER)
SMTP_REMITENTE=
# starttls | ssl | ninguna (ninguna solo para pruebas locales sin cifrado)
SMTP_SEGURIDAD=starttls
# Segundos de espera al conectar con el servidor de correo
SMTP_TIMEOUT=10
